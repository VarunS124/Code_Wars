def has_exit(maze):
    l1 = []
    l2 = []
    l3 = []
    out = False

    for i in range(len(maze)):
        for j in range(len(maze[i])):
            if maze[i][j] == 'k':
                l1.append([i, j])
            elif maze[i][j] == ' ':
                l2.append([i, j])

    if len(l1) != 1:
        raise ValueError("There must be exactly one Kate")

    r, c = l1[0]

    for i, j in l2:
        if (i == 0 or i == len(maze) - 1 or
            j == 0 or j == len(maze[i]) - 1):
            l3.append([i, j])

    queue = [[r, c]]
    visited = [[r, c]]

    while queue:
        r, c = queue.pop(0)

        if (r == 0 or r == len(maze) - 1 or
            c == 0 or c == len(maze[r]) - 1):
            return True
        for dr, dc in [(0, -1), (-1, 0), (0, 1), (1, 0)]:
            nr = r + dr
            nc = c + dc
            if 0 <= nr < len(maze) and 0 <= nc < len(maze[nr]):
                if maze[nr][nc] == ' ' and [nr, nc] not in visited:
                    queue.append([nr, nc])
                    visited.append([nr, nc])   
    return False

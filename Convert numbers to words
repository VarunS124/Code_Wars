def one_dig(n):
  if n in dict1:
    return dict1[n]

    
def two_dig(n):
    if n < 10:
        return dict1[n]
    if n in dict2:
        return dict2[n]
    if n in dict3:
        return dict3[n]
    tens = (n // 10) * 10
    ones = n % 10
    return dict3[tens] + " " + dict1[ones]

def three_dig(n):
  if(n<100):
    return two_dig(n)
  a=n%100
  n=n//100
  s=""
  s+=str(dict1[n]+" Hundred ")
  if a==0:
    return s
  elif a>0 and a<=9:
    s+="and "+dict1[a]
  elif a>=10 and a<=19:
    s+="and "+dict2[a]
  elif a in dict3:
    s+="and "+dict3[a]
  else:
    s+="and "+two_dig(a)
  return s


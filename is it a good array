class Solution {
    public boolean isGoodArray(int[] nums) {
        int res = nums[0];

        for (int i = 1; i < nums.length; i++) {
            res = gcd(res, nums[i]);
        }

        return res == 1;
    }

    int gcd(int a, int b) {
        if (a == 0)
            return b;

        return gcd(b % a, a);
    }
}

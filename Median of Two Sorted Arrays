class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int k=0;
        int[] c=new int[nums1.length+nums2.length];
        for(int i=0;i<nums1.length;i++){
            c[k]=nums1[i];
            k++;
        }
        for(int i=0;i<nums2.length;i++){
            c[k]=nums2[i];
            k++;
        }
        Arrays.sort(c);
        int median=0;
        if(c.length%2!=0){
            median=c[c.length/2];
        }
        else{
            return (c[c.length/2]+c[(c.length/2)-1])/2.0;
        }
        return median;
    }
}
